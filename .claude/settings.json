{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push origin*)",
      "Bash(git pull*)",
      "Bash(git checkout -b *)",
      "Bash(git branch*)",
      "Bash(mkdir *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pytest*)",
      "Bash(pip install *)",
      "Bash(sqlite3 *)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(yarn *)",
      "Bash(pnpm *)",
      "Bash(cat .env*)",
      "Bash(type .env*)",
      "Read(./.env)"
    ]
  }
}
